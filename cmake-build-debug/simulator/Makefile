# target to preprocess a source file
source/platform_ui_adapter.cc.i:
	cd /home/lingwei/github_repo/dg_fsm/cmake-build-debug && $(MAKE) $(MAKESILENT) -f simulator/CMakeFiles/simulation_library.dir/build.make simulator/CMakeFiles/simulation_library.dir/source/platform_ui_adapter.cc.i
.PHONY : source/platform_ui_adapter.cc.i

source/platform_ui_adapter.s: source/platform_ui_adapter.cc.s
.PHONY : source/platform_ui_adapter.s

# target to generate assembly for a file
